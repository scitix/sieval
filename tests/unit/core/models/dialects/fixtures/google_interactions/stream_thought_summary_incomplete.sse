event: step.delta
data: {"index":1,"delta":{"text":"The sum of the first $n$ positive odd integers is given by","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":" the formula $1 + 3 + 5 + \\dots + (2n-1) = n^2$.\n\n###","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":" Proof by Induction\n* **Base Case:** For $n = 1$, the sum is $1 = 1","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":"^2$, which is true.\n* **Inductive Step:** Assume the statement holds for $n = k$,","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":" meaning $1 + 3 + \\dots + (2k-1) = k^2$. \n  ","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":"\n  For $n = k + 1$, add the next odd integer, $(2k + 1)$, to both","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":" sides:\n  $$1 + 3 + \\dots + (2k-1) + (2k+","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":"1) = k^2 + (2k+1) = (k+1)^2$$\n  Since","type":"text"},"event_type":"step.delta"}

event: step.delta
data: {"index":1,"delta":{"text":" the formula holds for $k+1$, it is proven for all positive integers $n","type":"text"},"event_type":"step.delta"}

